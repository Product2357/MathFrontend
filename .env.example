DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mathmentor?schema=public"

# Supabase: Project -> Connect -> "Session pooler" (port 5432, IPv4-compatible,
# supports prepared statements, so Prisma, migrations and the Go API can all use it).
# URL-encode special characters in the password.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

GO_BACKEND_URL="http://localhost:8080"
GO_BACKEND_API_TOKEN="replace-with-a-long-random-server-only-token"